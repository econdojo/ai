class LossFunctions:
    """Implementation of SVM and Softmax loss functions."""
    
    @staticmethod
    def svm_loss_single(scores: np.ndarray, y_i: int, delta: float = 1.0) -> float:
        """
        Compute SVM loss for a single example.
        
        Args:
            scores: score vector of shape (K,)
            y_i: true class label (integer)
            delta: margin parameter
        
        Returns:
            loss: scalar SVM loss for this example
        """
        correct_class_score = scores[y_i]
        losses = np.maximum(0, scores - correct_class_score + delta)
        losses[y_i] = 0  # Don't count the correct class
        return np.sum(losses)
    
    @staticmethod
    def svm_loss_batch(X: np.ndarray, y: np.ndarray, W: np.ndarray, b: np.ndarray, 
                      reg_lambda: float = 0.01, delta: float = 1.0) -> Tuple[float, float, float]:
        """
        Compute SVM loss for batch of examples with L2 regularization.
        
        Args:
            X: data matrix of shape (N, D)
            y: labels of shape (N,)
            W: weight matrix of shape (K, D)
            b: bias vector of shape (K,)
            reg_lambda: regularization strength
            delta: margin parameter
        
        Returns:
            loss: total loss (scalar)
            data_loss: average data loss (scalar)
            reg_loss: regularization loss (scalar)
        """
        N = X.shape[0]
        scores = LinearScoreFunctions.batch_linear_score(X, W, b)
        
        # Compute data loss
        data_loss = 0.0
        for i in range(N):
            data_loss += LossFunctions.svm_loss_single(scores[i], y[i], delta)
        data_loss /= N
        
        # Compute regularization loss
        reg_loss = 0.5 * reg_lambda * np.sum(W * W)
        
        total_loss = data_loss + reg_loss
        return total_loss, data_loss, reg_loss
    
    @staticmethod
    def softmax_loss_single(scores: np.ndarray, y_i: int) -> Tuple[float, np.ndarray]:
        """
        Compute softmax loss for a single example.
        
        Args:
            scores: score vector of shape (K,)
            y_i: true class label (integer)
        
        Returns:
            loss: scalar softmax loss for this example
            probabilities: softmax probabilities of shape (K,)
        """
        # Numerical stability: subtract max
        scores_shifted = scores - np.max(scores)
        exp_scores = np.exp(scores_shifted)
        probabilities = exp_scores / np.sum(exp_scores)
        
        loss = -np.log(probabilities[y_i] + 1e-8)  # Small epsilon to avoid log(0)
        return loss, probabilities
    
    @staticmethod
    def compare_losses(scores: np.ndarray, y_true: int) -> Tuple[float, float]:
        """
        Compare SVM and Softmax losses for the same predictions.
        
        Args:
            scores: score vector of shape (K,)
            y_true: true class label (integer)
        
        Returns:
            svm_loss: SVM loss value
            softmax_loss: Softmax loss value
        """
        svm_loss_val = LossFunctions.svm_loss_single(scores, y_true)
        softmax_loss_val, _ = LossFunctions.softmax_loss_single(scores, y_true)
        return svm_loss_val, softmax_loss_val


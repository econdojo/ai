class GradientDescent:
    """Implementation of gradient descent for linear classifier training."""
    
    @staticmethod
    def train_linear_classifier(X: np.ndarray, y: np.ndarray, learning_rate: float = 0.001, 
                               num_epochs: int = 1000, reg_lambda: float = 0.01, 
                               batch_size: int = None, verbose: bool = True) -> Tuple[np.ndarray, np.ndarray, List[float]]:
        """
        Train a linear classifier using gradient descent.
        
        Args:
            X: training data of shape (N, D)
            y: training labels of shape (N,)
            learning_rate: step size for gradient descent
            num_epochs: number of training epochs
            reg_lambda: regularization strength
            batch_size: if None, use full batch; otherwise use mini-batches
            verbose: print training progress
        
        Returns:
            W: trained weights of shape (K, D)
            b: trained biases of shape (K,)
            loss_history: list of loss values during training
        """
        N, D = X.shape
        K = np.max(y) + 1
        
        # Initialize parameters
        W = np.random.randn(K, D) * 0.01
        b = np.zeros(K)
        
        loss_history = []
        
        for epoch in range(num_epochs):
            if batch_size is None:
                # Full batch
                batch_X = X
                batch_y = y
            else:
                # Mini-batch
                indices = np.random.choice(N, batch_size, replace=False)
                batch_X = X[indices]
                batch_y = y[indices]
            
            # Compute loss and gradients
            loss, dW, db = GradientComputation.svm_loss_and_grad(batch_X, batch_y, W, b, reg_lambda)
            
            # Update parameters
            W -= learning_rate * dW
            b -= learning_rate * db
            
            loss_history.append(loss)
            
            if verbose and epoch % 100 == 0:
                print(f"Epoch {epoch}, Loss: {loss:.4f}")
        
        return W, b, loss_history
    
    @staticmethod
    def compute_accuracy(X: np.ndarray, y: np.ndarray, W: np.ndarray, b: np.ndarray) -> float:
        """
        Compute classification accuracy.
        
        Args:
            X: data matrix of shape (N, D)
            y: true labels of shape (N,)
            W: weight matrix of shape (K, D)
            b: bias vector of shape (K,)
        
        Returns:
            accuracy: classification accuracy
        """
        scores = LinearScoreFunctions.batch_linear_score(X, W, b)
        predictions = np.argmax(scores, axis=1)
        return np.mean(predictions == y)
    
    @staticmethod
    def plot_training_results(loss_history: List[float], X_train: np.ndarray, y_train: np.ndarray,
                             W_trained: np.ndarray, b_trained: np.ndarray):
        """Plot training curve and accuracy."""
        train_acc = GradientDescent.compute_accuracy(X_train, y_train, W_trained, b_trained)
        
        plt.figure(figsize=(12, 4))
        
        plt.subplot(1, 2, 1)
        plt.plot(loss_history)
        plt.xlabel('Epoch')
        plt.ylabel('Loss')
        plt.title('Training Loss')
        plt.grid(True)
        
        plt.subplot(1, 2, 2)
        plt.bar(['Training Accuracy'], [train_acc], color=['skyblue'])
        plt.ylabel('Accuracy')
        plt.title('Final Accuracy')
        plt.ylim(0, 1)
        
        plt.tight_layout()
        plt.show()
        
        print(f"Final training accuracy: {train_acc:.4f}")
        
        return train_acc
    
    @staticmethod
    def hyperparameter_analysis(X_train: np.ndarray, y_train: np.ndarray):
        """Study the effect of different hyperparameters on training."""
        
        # Learning rate analysis
        learning_rates = [0.001, 0.01, 0.1, 1.0]
        colors = ['blue', 'green', 'red', 'orange']
        
        plt.figure(figsize=(12, 4))
        
        plt.subplot(1, 2, 1)
        for i, lr in enumerate(learning_rates):
            _, _, loss_hist = GradientDescent.train_linear_classifier(
                X_train, y_train, 
                learning_rate=lr, 
                num_epochs=200, 
                verbose=False
            )
            plt.plot(loss_hist, color=colors[i], label=f'LR={lr}')
        
        plt.xlabel('Epoch')
        plt.ylabel('Loss')
        plt.title('Effect of Learning Rate')
        plt.legend()
        plt.grid(True)
        plt.yscale('log')
        
        # Regularization analysis
        reg_lambdas = [0.0, 0.001, 0.01, 0.1]
        
        plt.subplot(1, 2, 2)
        for i, reg in enumerate(reg_lambdas):
            _, _, loss_hist = GradientDescent.train_linear_classifier(
                X_train, y_train, 
                learning_rate=0.01, 
                reg_lambda=reg,
                num_epochs=200, 
                verbose=False
            )
            plt.plot(loss_hist, color=colors[i], label=f'λ={reg}')
        
        plt.xlabel('Epoch')
        plt.ylabel('Loss')
        plt.title('Effect of Regularization')
        plt.legend()
        plt.grid(True)
        
        plt.tight_layout()
        plt.show()


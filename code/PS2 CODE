class GradientComputation:
    """Implementation of numerical and analytical gradient computation."""
    
    @staticmethod
    def numerical_gradient(f: callable, x: np.ndarray, h: float = 1e-5) -> np.ndarray:
        """
        Compute numerical gradient using finite differences.
        
        Args:
            f: function that takes x and returns scalar
            x: point at which to evaluate gradient (any shape)
            h: step size for finite difference
        
        Returns:
            grad: gradient of same shape as x
        """
        grad = np.zeros_like(x)
        
        # Iterate over all elements
        it = np.nditer(x, flags=['multi_index'], op_flags=['readwrite'])
        while not it.finished:
            idx = it.multi_index
            old_val = x[idx]
            
            # f(x + h)
            x[idx] = old_val + h
            fx_plus = f(x)
            
            # f(x - h)
            x[idx] = old_val - h
            fx_minus = f(x)
            
            # Gradient
            grad[idx] = (fx_plus - fx_minus) / (2 * h)
            
            # Restore original value
            x[idx] = old_val
            it.iternext()
        
        return grad
    
    @staticmethod
    def svm_loss_and_grad(X: np.ndarray, y: np.ndarray, W: np.ndarray, b: np.ndarray, 
                         reg_lambda: float = 0.01, delta: float = 1.0) -> Tuple[float, np.ndarray, np.ndarray]:
        """
        Compute SVM loss and gradients analytically.
        
        Args:
            X: data matrix of shape (N, D)
            y: labels of shape (N,)
            W: weight matrix of shape (K, D)
            b: bias vector of shape (K,)
            reg_lambda: regularization strength
            delta: margin parameter
        
        Returns:
            loss: total loss (scalar)
            dW: gradient w.r.t. weights of shape (K, D)
            db: gradient w.r.t. biases of shape (K,)
        """
        N, D = X.shape
        K = W.shape[0]
        
        # Forward pass
        scores = LinearScoreFunctions.batch_linear_score(X, W, b)
        data_loss = 0.0
        
        # Initialize gradients
        dW = np.zeros_like(W)
        db = np.zeros_like(b)
        
        for i in range(N):
            scores_i = scores[i]
            y_i = y[i]
            correct_score = scores_i[y_i]
            
            # Count number of classes that violate margin
            margin_count = 0
            for j in range(K):
                if j == y_i:
                    continue
                    
                margin = scores_i[j] - correct_score + delta
                if margin > 0:
                    data_loss += margin
                    # Gradient for incorrect classes
                    dW[j] += X[i]
                    db[j] += 1
                    margin_count += 1
            
            # Gradient for correct class
            dW[y_i] -= margin_count * X[i]
            db[y_i] -= margin_count
        
        # Average data loss and gradients
        data_loss /= N
        dW /= N
        db /= N
        
        # Add regularization
        reg_loss = 0.5 * reg_lambda * np.sum(W * W)
        total_loss = data_loss + reg_loss
        
        # Add regularization gradient
        dW += reg_lambda * W
        
        return total_loss, dW, db
    
    @staticmethod
    def gradient_check(numerical_grad: np.ndarray, analytical_grad: np.ndarray, 
                      threshold: float = 1e-6) -> Tuple[float, bool]:
        """
        Check if numerical and analytical gradients match.
        
        Args:
            numerical_grad: numerically computed gradient
            analytical_grad: analytically computed gradient
            threshold: tolerance for relative error
        
        Returns:
            relative_error: relative error between gradients
            passed: True if gradient check passes
        """
        numerator = np.abs(numerical_grad - analytical_grad)
        denominator = np.abs(numerical_grad) + np.abs(analytical_grad)
        relative_error = numerator / (denominator + 1e-8)  # Avoid division by zero
        
        max_error = np.max(relative_error)
        passed = max_error < threshold
        
        return max_error, passed


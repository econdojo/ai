class LinearScoreFunctions:
    """Implementation of linear score functions and geometric interpretation."""
    
    @staticmethod
    def linear_score(x_i: np.ndarray, W: np.ndarray, b: np.ndarray) -> np.ndarray:
        """
        Compute linear scores for a single example.
        
        Args:
            x_i: feature vector of shape (D,)
            W: weight matrix of shape (K, D) 
            b: bias vector of shape (K,)
        
        Returns:
            scores: score vector of shape (K,)
        """
        return W @ x_i + b
    
    @staticmethod
    def batch_linear_score(X: np.ndarray, W: np.ndarray, b: np.ndarray) -> np.ndarray:
        """
        Compute linear scores for batch of examples.
        
        Args:
            X: data matrix of shape (N, D)
            W: weight matrix of shape (K, D)
            b: bias vector of shape (K,)
        
        Returns:
            scores: score matrix of shape (N, K)
        """
        return X @ W.T + b
    
    @staticmethod
    def visualize_decision_boundary():
        """Create and visualize decision boundary for 2D binary classification."""
        np.random.seed(42)
        n_points = 100
        X_2d = np.random.randn(n_points, 2) * 2
        
        # Define a simple linear classifier
        W_2d = np.array([[1.0, -0.5]])  # shape (1, 2)
        b_2d = np.array([0.0])          # shape (1,)
        
        # Compute scores and predictions
        scores_2d = LinearScoreFunctions.batch_linear_score(X_2d, W_2d, b_2d).flatten()
        predictions = (scores_2d > 0).astype(int)
        
        # Create visualization
        plt.figure(figsize=(10, 8))
        
        # Plot data points
        colors = ['red' if pred == 0 else 'blue' for pred in predictions]
        plt.scatter(X_2d[:, 0], X_2d[:, 1], c=colors, alpha=0.6, edgecolors='w', s=50)
        
        # Plot decision boundary: w1*x1 + w2*x2 + b = 0 => x2 = -(w1*x1 + b)/w2
        x1_boundary = np.linspace(-6, 6, 100)
        x2_boundary = -(W_2d[0, 0] * x1_boundary + b_2d[0]) / W_2d[0, 1]
        plt.plot(x1_boundary, x2_boundary, 'k-', linewidth=2, label='Decision Boundary')
        
        plt.xlabel('Feature 1 (x1)')
        plt.ylabel('Feature 2 (x2)')
        plt.title('2D Binary Classification with Linear Decision Boundary')
        plt.grid(True, alpha=0.3)
        plt.legend()
        plt.axis('equal')
        plt.show()
        
        return W_2d, b_2d, X_2d, predictions


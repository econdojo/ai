class BackpropagationPyTorch:
    """Implementation of manual backpropagation and PyTorch automatic differentiation."""
    
    @staticmethod
    def composite_function_forward(x: float, y: float, z: float, w: float) -> Tuple[float, Dict[str, Any]]:
        """
        Forward pass of the composite function: f(x, y, z, w) = 2 * (x * y + max(z, w))
        
        Returns:
            f: final output
            intermediates: dictionary of intermediate values for backprop
        """
        p = x * y
        q = max(z, w)
        v = p + q
        f = 2 * v
        
        intermediates = {'x': x, 'y': y, 'z': z, 'w': w, 'p': p, 'q': q, 'v': v}
        return f, intermediates
    
    @staticmethod
    def composite_function_backward(intermediates: Dict[str, Any]) -> Dict[str, float]:
        """
        Backward pass of the composite function.
        
        Args:
            intermediates: dictionary from forward pass
        
        Returns:
            gradients: dictionary of gradients w.r.t. inputs
        """
        # df/dv = 2
        dv = 2
        
        # dv/dp = 1, dv/dq = 1
        dp = dv * 1
        dq = dv * 1
        
        # dp/dx = y, dp/dy = x
        dx = dp * intermediates['y']
        dy = dp * intermediates['x']
        
        # dq/dz = 1 if z > w else 0, dq/dw = 1 if w > z else 0
        dz = dq * 1 if intermediates['z'] > intermediates['w'] else 0
        dw = dq * 1 if intermediates['w'] > intermediates['z'] else 0
        
        return {'x': dx, 'y': dy, 'z': dz, 'w': dw}
    
    @staticmethod
    def composite_function_pytorch(x_val: float, y_val: float, z_val: float, w_val: float) -> Tuple[float, Tuple[float, float, float, float]]:
        """
        Implement composite function using PyTorch automatic differentiation.
        
        Returns:
            f: function value
            gradients: tuple of gradients (df/dx, df/dy, df/dz, df/dw)
        """
        x = torch.tensor(x_val, requires_grad=True)
        y = torch.tensor(y_val, requires_grad=True)
        z = torch.tensor(z_val, requires_grad=True)
        w = torch.tensor(w_val, requires_grad=True)
        
        p = x * y
        q = torch.max(z, w)
        v = p + q
        f = 2 * v
        
        f.backward()
        
        gradients = (x.grad.item(), y.grad.item(), z.grad.item(), w.grad.item())
        return f.item(), gradients
    
    @staticmethod
    def composite_function_scalar(inputs: np.ndarray) -> float:
        """Scalar version for numerical gradient computation."""
        x, y, z, w = inputs
        p = x * y
        q = max(z, w)
        v = p + q
        f = 2 * v
        return f

